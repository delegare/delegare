{
  "name": "@delegare/mcp-server",
  "version": "0.1.0",
  "description": "Delegare MCP Server with Skybridge UI Widgets",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:skybridge --external:zod --external:@modelcontextprotocol/sdk",
    "build:web": "vite build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@delegare/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "skybridge": "latest",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.20.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0"
  }
}
