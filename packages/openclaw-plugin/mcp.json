{
  "name": "Delegare",
  "description": "Trustless payment delegation for AI agents. Authorize your agent to pay for services within spending limits you control.",
  "type": "mcp-server",
  "version": "0.1.0",
  "icon": "https://delegare.dev/logo.png",
  "auth": {
    "type": "oauth2",
    "authorizationUrl": "https://delegare.dev/oauth/authorize",
    "tokenUrl": "https://api.delegare.dev/v1/oauth/token",
    "scopes": ["pay", "balance", "revoke"]
  },
  "command": "node",
  "args": ["@delegare/openclaw-plugin/bin/run.js"]
}
