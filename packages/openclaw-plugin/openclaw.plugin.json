{
  "id": "delegare",
  "name": "Delegare",
  "version": "0.3.0",
  "description": "Delegare - Trustless payment delegation for AI agents in OpenClaw",
  "entrypoint": "./dist/index.js",
  "setupEntrypoint": "./dist/setup-entry.js",
  "icon": "https://delegare.dev/logo.png",
  "auth": {
    "type": "oauth2",
    "authorizationUrl": "https://api.delegare.dev/v1/oauth2/authorize",
    "tokenUrl": "https://api.delegare.dev/v1/oauth2/token",
    "registrationUrl": "https://api.delegare.dev/v1/oauth2/register",
    "scopes": ["pay", "balance", "revoke"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string",
        "description": "Override the Delegare API base URL (e.g. https://api.sandbox.delegare.dev/v1)",
        "default": "https://api.delegare.dev/v1"
      },
      "environment": {
        "type": "string",
        "description": "The Delegare environment (sandbox, prod)",
        "default": "prod"
      }
    }
  }
}
