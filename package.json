{
  "name": "delegare",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "deploy:dev": "cd infrastructure && pnpm cdk deploy --all --context environment=dev",
    "deploy:prod": "cd infrastructure && pnpm cdk deploy --all --context environment=prod",
    "sdk:publish": "cd packages/sdk && pnpm publish --access public",
    "mcp-tools:publish": "cd packages/mcp-tools && pnpm publish --access public"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "msw", "sharp", "unrs-resolver"]
  },
  "devDependencies": {
    "next": "16.2.6",
    "typescript": "5.9.3"
  }
}
