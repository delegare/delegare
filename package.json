{
  "name": "delegare",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "sdk:publish": "cd packages/sdk && pnpm publish --access public",
    "x402:publish": "cd packages/x402 && pnpm publish --access public",
    "mcp-tools:publish": "cd packages/mcp-tools && pnpm publish --access public",
    "openclaw-plugin:publish": "cd packages/openclaw-plugin && pnpm publish --access public"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "msw", "sharp", "unrs-resolver"]
  },
  "devDependencies": {
    "next": "16.2.6",
    "typescript": "5.9.3"
  }
}
