# Your Delegare API Credentials
# Get these from your merchant dashboard (https://app.delegare.dev)

DELEGARE_MERCHANT_ID=m_your_merchant_id
DELEGARE_API_KEY=dk_test_your_secret_key

# Optional: Your USDC wallet address on Base. 
# Required only if you want to accept USDC payments via the x402 protocol.
#MERCHANT_USDC_WALLET=0x0000000000000000000000000000000000000000

DELEGARE_BASE_URL=https://api.sandbox.delegare.dev/v1

# Required only if you want to test the x402 paywall locally using `pnpm x402`.
# Generate this using `pnpm setup` and paste the resulting token here.
# DELEGARE_MANDATE=eyJhbGci...

# Optional: Set this to a local URL when developing Delegare locally
# DELEGARE_BASE_URL=http://localhost:3000
